name = "kokic/uml-profile"

version = "0.1.0"

import {
  "kokic/uml@0.1.5",
  "moonbitlang/x@0.5.1",
  "Milky2018/svgdiff@0.10.1",
}

readme = "README.md"

repository = "https://github.com/moonbit-community/uml"

license = "Apache-2.0"

keywords = [ "uml", "plantuml", "svg", "cli" ]

description = "Command-line tool to render PlantUML diagrams as SVG"

preferred_target = "wasm"
