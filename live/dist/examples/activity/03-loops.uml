@startuml
title Batch processing and delivery retries
start
:Open batch;
while (More records?) is (yes)
  :Read record; <<input>>
  :Process record; <<procedure>>
end while (no)
repeat :Prepare delivery; <<output>> <<#lightblue>>
  :Attempt delivery;
  backward :Wait before retry; <<procedure>> <<#wheat>>
repeat while (Delivery failed?) is (retry) not (done) <<#lightyellow>>
stop
@enduml
