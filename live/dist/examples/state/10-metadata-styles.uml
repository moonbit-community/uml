@startuml
skinparam BackgroundColor #f8f9fa
skinparam StateBackgroundColor #f1f3f5
skinparam StateBackgroundColor<<warning>> #ffe3e3
skinparam StateBorderColor<<warning>> #c92a2a
skinparam NoteBackgroundColor #fff3bf
skinparam NoteBorderColor #e67700

state Styled <<warning>> [[https://example.com/styled]]
state Plain

Styled --> Plain : continue

note right of Styled
  Uses the note style.
end note

note on link #lightblue : inline color wins
@enduml
