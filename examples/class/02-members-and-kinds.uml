@startuml
abstract class "Account Holder" as Account {
  + id : UUID
  # displayName : String
  - credentials : Credential
  --
  + login() : Session
  # verifyCredential() : Bool
}

interface Authenticatable {
  + authenticate(token : String) : Session
}

enum AccountStatus {
  Pending
  Active
  Suspended
}

class Customer extends Account implements Authenticatable {
  + status : AccountStatus
  + authenticate(token : String) : Session
}
@enduml
