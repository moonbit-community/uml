@startuml
json "Customer profile" as Profile <<payload>> #lightgreen {
  "name": "Ada",
  "active": true,
  "preferences": {
    "locale": "en-GB",
    "template": "{customer}/{order}"
  }
}

json RetryCount 3
json Tags ["priority", "export"]
json EmptyValue null

object Customer
Customer --> Profile : serialized profile
@enduml
