@startuml
left to right direction

package "Sales domain" as sales <<bounded context>> #lightblue {
  class Order
  class Customer

  package fulfillment {
    class Shipment
  }
}

namespace "External API" as external.api {
  interface ShippingProvider
}

sales.Order --> sales.fulfillment.Shipment : creates
sales.fulfillment.Shipment ..> external.api.ShippingProvider : dispatches through
@enduml
