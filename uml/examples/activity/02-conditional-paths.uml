@startuml
start
:Load account;

if (Account exists?) then (yes)
  :Check account status;
  if (Account enabled?) then (yes)
    :Continue sign in;
  else (no)
    :Show disabled message;
  endif
elseif (Guest access allowed?) then (guest)
  :Create guest session;
else (no)
  :Show registration prompt;
endif

stop
@enduml
